TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=orchestration
ORCHESTRATOR_DATA_DIR=./data
ORCHESTRATOR_HOST_DATA_DIR=C:/workspace/test-orch/data
ORCHESTRATOR_PROJECTS_ROOT=C:/workspace/orchestration-projects
ORCHESTRATOR_MAX_ACTIVITY_CONCURRENCY=2
ORCHESTRATOR_QUEUE_WAIT_ALERT_MS=60000
OPENROUTER_API_KEY=
CALCULATOR_PROJECT_ROOT=C:/workspace/calculator
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=
# Company-scoped board API key; worker requires it to recheck dependencies.
PAPERCLIP_API_TOKEN=
# Host worker URL used to recheck blockers before branch creation.
PAPERCLIP_API_URL=http://127.0.0.1:3100
# Set to 1 only for scenario testing: lets the bridge accept test-injection flags.
ORCHESTRATOR_ALLOW_TEST_FLAGS=0

# Unity games (docs/engineering/research/unity-game-support.md)
# Short worktree folder: Unity Android builds fail on long project paths.
ORCHESTRATOR_WORKTREES_DIR=C:/w
# Unity's official agent plugin, pinned by `npm run unity:plugin`; Claude loads it with --plugin-dir in Unity projects.
UNITY_AGENT_PLUGIN_DIR=C:/workspace/test-orch/data/unity-agent-plugin
# Optional: UNITY_EDITOR_PATH (default: newest 6000.x under the Hub), UNITY_IMPORT_TIMEOUT_SECONDS

# 1 = the worker reports a finished run to its Paperclip issue itself (ADR 0018); 0 = only the adapter and the reconcile step do. Needs PAPERCLIP_API_TOKEN on the worker.
ORCHESTRATOR_WORKER_REPORTS=0
