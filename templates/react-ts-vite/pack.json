{
  "id": "react-ts-vite",
  "description": "Engineering standards pack for React + TypeScript + Vite projects (ADR 0034, 0035): canonical AGENTS.md with rule ids, enforcement manifest, lint rules, check scripts, page-doc and debt-ledger templates, root scale tokens.",
  "copy": [
    "AGENTS.md",
    "CLAUDE.md",
    "docs/ai/enforcement.json",
    "docs/ai/INDEX.md",
    "docs/technical-debt/LEDGER.md",
    "docs/pages/_TEMPLATE.md",
    ".github/pull_request_template.md",
    "eslint.config.js",
    "renovate.json",
    "src/styles/tokens.css",
    "scripts/check-ai-files.mjs",
    "scripts/check-debt-ledger.mjs",
    "scripts/check-page-docs.mjs",
    "scripts/check-style-tokens.mjs",
    "scripts/generate-ai-index.mjs",
    "scripts/check-journeys.mjs",
    "scripts/check-module-contracts.mjs",
    "docs/ai/MODULE_README_TEMPLATE.md",
    "e2e/journeys/_TEMPLATE.md",
    ".github/workflows/drift.yml",
    ".dependency-cruiser.cjs"
  ],
  "render": ["AGENTS.md", "docs/ai/INDEX.md"],
  "standards": { "from": "docs/standards/react-ts-vite.md", "to": "ENGINEERING_STANDARDS.md" },
  "directories": ["docs/decisions", "docs/migration", "docs/pages", "src/components", "src/hooks", "src/input", "src/pages", "src/services", "src/storage"],
  "seed": {
    "docs/migration/findings.md": "# Findings for a decision\n\nChanges that would alter architecture or visible behaviour. Do not make them silently: describe the finding, the options, the recommendation, and keep the old behaviour until it is decided.\n",
    "docs/migration/todo.md": "# TODO (not done)\n\nWork a task could not finish or deliberately left. One line each, with the file or page and why.\n",
    "docs/migration/map.md": "# Migration map\n\n| old file | new file | status | tests |\n|---|---|---|---|\n"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "vite build",
    "test:related": "vitest related --run --passWithNoTests",
    "test:input": "vitest run src/input --passWithNoTests",
    "test:storage": "vitest run src/storage --passWithNoTests",
    "test:services": "vitest run src/services --passWithNoTests",
    "test:pages": "vitest run src/pages --passWithNoTests",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "jscpd": "jscpd src --min-lines 10 --threshold 5 --reporters console --silent",
    "check:ai": "node scripts/check-ai-files.mjs",
    "check:debt": "node scripts/check-debt-ledger.mjs",
    "check:pages": "node scripts/check-page-docs.mjs",
    "check:styles": "node scripts/check-style-tokens.mjs",
    "check:journeys": "node scripts/check-journeys.mjs",
    "check:contracts": "node scripts/check-module-contracts.mjs",
    "ai:index": "node scripts/generate-ai-index.mjs",
    "check:index": "node scripts/generate-ai-index.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run knip && npm run depcruise && npm run jscpd && npm run check:ai && npm run check:debt && npm run check:pages && npm run check:styles && npm run check:index && npm run check:journeys && npm run check:contracts"
  },
  "removeDevDependencies": ["oxlint"],
  "replaceScripts": { "lint": ["oxlint"] },
  "gates": [
    { "script": "typecheck", "parallel": true },
    { "script": "lint", "parallel": true },
    { "script": "knip", "parallel": true },
    { "script": "depcruise", "parallel": true },
    { "script": "jscpd", "parallel": true },
    { "script": "check:ai", "parallel": true },
    { "script": "check:debt", "parallel": true },
    { "script": "check:pages", "parallel": true },
    { "script": "check:styles", "parallel": true },
    { "script": "check:index", "parallel": true },
    { "script": "check:journeys", "parallel": true },
    { "script": "check:contracts", "parallel": true },
    { "script": "test:related", "extra": ["--", "{changed}"] },
    { "script": "build" },
    { "script": "test", "scope": "milestone" }
  ],
  "devDependencies": ["typescript@~6.0.3", "vitest", "eslint@^9.39.5", "@eslint/js@^9.39.5", "typescript-eslint", "eslint-plugin-react-hooks", "eslint-plugin-jsx-a11y", "eslint-plugin-jsdoc", "globals", "knip", "dependency-cruiser", "jscpd"],
  "mainImports": ["./styles/tokens.css"]
}
