  "uiUx": {
    "enabled": true,
    "autoSelect": true,
    "include": [],
    "exclude": []
  },
  "policy": {
    "maxReviewRounds": 1,
    "maxParallelism": 1,
    "requireApprovalBeforeMerge": false
  },
  "reference": {
    "root": "luxus-app",
    "label": "legacy Nuxt 2 app (read-only)"
  },
  "intelligence": {
    "tools": {
      "ts-imports": {
        "mode": "advisory"
      },
      "affected-tests": {
        "mode": "advisory"
      },
      "pkg-deps": {
        "mode": "advisory"
      }
    }
  },
  "skills": {
    "include": [
      "vue2-nuxt2-reading"
    ],
    "budgetChars": 4500
  },
  "review": {
    "specialists": [
      {
        "id": "storage",
        "paths": [
          "src/storage/**",
          "src/services/cache*/**",
          "src/services/cache*.ts"
        ],
        "focus": "Catalogue and frequently written data go through the storage interface to IndexedDB; check batching, a stated size limit and eviction, quota and write failures, and that nothing outside src/storage touches localStorage."
      },
      {
        "id": "input",
        "paths": [
          "src/input/**"
        ],
        "focus": "Only src/input listens for keys and pointer keys; check focus regions, focus restoration, modal containment, and that native key handling in text fields is preserved on remote, keyboard, mouse and touch."
      },
      {
        "id": "xtream",
        "paths": [
          "src/services/xtream*/**",
          "src/services/xtream*.ts"
        ],
        "focus": "The Xtream adapter is the single typed entry for the provider; check runtime validation of responses, timeouts, cancellation and backoff, no retry of authentication failures, and that credentials never reach logs or analytics."
      },
      {
        "id": "carousel",
        "paths": [
          "src/components/carousel*/**",
          "src/components/*Carousel*"
        ],
        "focus": "The carousel is a protected component: check that rows are virtualised and paged, memory stays bounded while scrolling, focus movement stays predictable, and every observer and timer is cleaned up."
      },
      {
        "id": "player",
        "paths": [
          "src/player/**",
          "src/services/player*/**",
          "src/components/player*/**"
        ],
        "focus": "Playback code owns media resources: check that every media element, listener and request has an owner and a cleanup, that errors surface to the user, and that devices on the Chrome 53 tier still work."
      }
    ]
  },
  "designGate": {
    "enabled": true,
    "dir": "docs/design",
    "areas": [
      "cache-storage",
      "input",
      "xtream-fetch",
      "carousel",
      "player-native"
    ]
  }
}
