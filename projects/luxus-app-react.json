{
  "id": "luxus-app-react",
  "aliases": [],
  "name": "Luxus App React",
  "root": "luxus-app-react",
  "containerRoot": "/workspace/projects/luxus-app-react",
  "repository": {
    "remote": "origin",
    "targetBranch": "main",
    "requiredSourcePaths": [
      "AGENTS.md"
    ]
  },
  "defaultProfile": "implementation",
  "tier": "prototype",
  "openSpec": {
    "enabled": false
  },
  "analysis": {
    "enabled": false,
    "docsDir": "docs/analysis"
  },
  "providers": {
    "default": "codex"
  },
  "providerRouting": {
    "plan": {
      "provider": "codex"
    },
    "research": {
      "provider": "codex"
    },
    "review": {
      "provider": "claude"
    },
    "verify": {
      "provider": "codex"
    },
    "implement": {
      "provider": "codex",
      "fallback": [
        {
          "provider": "claude"
        }
      ]
    },
    "analyze": {
      "provider": "codex"
    },
    "openspec": {
      "provider": "codex"
    },
    "survey": {
      "provider": "codex"
    }
  },
  "providerTimeouts": {
    "implement": 900000,
    "openspec": 720000
  },
  "stack": {
    "profile": "react-ts"
  },
  "qualityCommands": [
