{
  "name": "paperclip-temporal-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node dist/src/cli.js",
    "worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-worker.ps1",
    "worker:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-worker-task.ps1",
    "worker:node": "node dist/src/worker.js",
    "demo": "node dist/src/demo.js",
    "demo:validate": "node dist/src/validate-demo.js",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "reset:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-demo.ps1",
    "runs": "tsx src/cli.ts runs",
    "setup": "npm ci",
    "doctor": "node dist/src/cli.js doctor",
    "cleanup": "node dist/src/cli.js cleanup",
    "timing": "node dist/src/cli.js timing",
    "unity:plugin": "node scripts/unity-plugin.mjs",
    "resume-run": "node dist/src/cli.js resume-run",
    "reconcile:watch": "node scripts/reconcile-watch.mjs",
    "drain": "node dist/src/cli.js drain",
    "reconcile": "node dist/src/cli.js reconcile",
    "deploy:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-worker.ps1",
    "e2e": "node dist/src/e2e.js",
    "bootstrap:e2e": "node dist/src/bootstrap-e2e.js",
    "plugin:build": "npm --prefix plugins/project-bootstrap run build",
    "plugin:setup": "node dist/src/plugin-setup.js",
    "check:chars": "node scripts/check-control-chars.mjs",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "ci:linux": "sh scripts/ci-linux.sh"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.14.3",
    "@openai/codex": "0.163.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0",
    "@types/node": "22.15.30",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
